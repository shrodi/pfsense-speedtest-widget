			<media></media>
			<mediaopt></mediaopt>
			<dhcp6-duid></dhcp6-duid>
			<dhcp6-ia-pd-len>0</dhcp6-ia-pd-len>
			<descr><![CDATA[WAN]]></descr>
		</wan>
		<lan>
			<enable></enable>
			<if>igc1</if>
			<descr><![CDATA[CONF]]></descr>
			<spoofmac></spoofmac>
			<ipaddr>192.168.5.1</ipaddr>
			<subnet>24</subnet>
