		<opt4>
			<descr><![CDATA[ETH5]]></descr>
			<if>igc5</if>
			<enable></enable>
			<spoofmac></spoofmac>
		</opt4>
		<opt5>
			<descr><![CDATA[LAN]]></descr>
			<if>bridge0</if>
			<enable></enable>
			<spoofmac></spoofmac>
			<ipaddr>192.168.1.1</ipaddr>
			<subnet>24</subnet>
			<ipaddrv6>track6</ipaddrv6>
			<track6-interface>wan</track6-interface>
			<track6-prefix-id>0</track6-prefix-id>
		</opt5>
